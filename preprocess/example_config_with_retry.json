{
  "scene_config": {
    "scene_path": "/path/to/scene.glb",
    "goal_object": "chair"
  },
  "output": {
    "output_dir": "/path/to/output"
  },
  "llm_config": {
    "api_key": "your_api_key_here",
    "base_url": "https://api.openai-proxy.org/google/v1beta/models",
    "model": "gemini-2.0-flash",
    "max_tokens": 1000,
    "max_retries": 3
  },
  "prompts": {
    "choose_room_prompt": "/path/to/choose_room_prompt.txt",
    "choose_node_prompt": "/path/to/choose_node_prompt.txt"
  },
  "topdown_generation": {
    "height_above_floor": 2.0,
    "pixels_per_meter": 50,
    "add_coordinate_text": true,
    "text_color": [255, 255, 255],
    "text_thickness": 2,
    "text_scale": 0.7
  },
  "room_segmentation": {
    "morph_closing_width_meters": 0.3,
    "seed_min_distance_from_wall_meters": 0.5,
    "min_room_area_pixels": 1000
  },
  "graph_generation": {
    "grid_spacing_meters": 0.5,
    "node_radius_pixels": 8,
    "connection_max_distance_meters": 1.0
  }
}
